{
  "name": "custodial-scheduler",
  "version": "0.1.0",
  "description": "Whitworth University Custodial Scheduling App",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node --watch server/index.js",
    "client": "vite client --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "db:init": "node scripts/init-db.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.21"
  }
}
